  {
    "id": "a1000000000dem01",
    "type": "function",
    "z": "a10000000000tab1",
    "name": "Core decode URL",
    "func": "// Asks Aloxy.Core to decode a test payload for a demo device. Core then\n// pushes the result to /aloxy, which forwards it to the dashboard, so this\n// tests the whole real path. msg.topic = device ID, msg.payload = hex.\nmsg.url = \"http://aloxy-core:8080/core/calculate/hex/\" + msg.topic;\nmsg.headers = { \"Content-Type\": \"text/plain\" };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
