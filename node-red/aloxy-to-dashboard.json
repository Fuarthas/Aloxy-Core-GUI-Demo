  {
    "id": "a1000000000fwd01",
    "type": "function",
    "z": "a10000000000tab1",
    "name": "to dashboard",
    "func": "// Sends Aloxy.Core data (one thing, or an array from things.json) to the\n// Vercel dashboard. URL and token come from the node-red container's\n// environment, so no secret is stored in this flow.\nconst base = env.get(\"DASHBOARD_URL\");\nconst token = env.get(\"INGEST_TOKEN\");\nif (!base || !token) {\n    node.warn(\"DASHBOARD_URL / INGEST_TOKEN not set on the node-red container\");\n    return null;\n}\nreturn {\n    url: base.replace(/\\/$/, \"\") + \"/api/ingest\",\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\", \"Authorization\": \"Bearer \" + token },\n    payload: msg.payload\n};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 120,
    "wires": [
      [
        "a1000000000req01"
      ]
    ]
  },
