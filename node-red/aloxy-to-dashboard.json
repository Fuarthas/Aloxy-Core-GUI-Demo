  {
    "id": "a1000000000lop01",
    "type": "function",
    "z": "a10000000000tab1",
    "name": "random valve + payload",
    "func": "// Demo loop: every tick, one random demo valve gets a random test payload.\nconst devices = [\"70B3D57BB1000001\", \"70B3D57BB1000002\", \"70B3D57BB1000003\"];\nconst payloads = [\n    \"205a000c04b50000006010c001010d00\", // 0 %\n    \"205a000c04b50100006010c001010d00\", // 100 %\n    \"205a000c04b50100006010c001010d00\", // 100 % (weighted: mostly open)\n    \"205a000c0482e0ffffc5184102021900\"  // invalid position\n];\nmsg.topic = devices[Math.floor(Math.random() * devices.length)];\nmsg.payload = payloads[Math.floor(Math.random() * payloads.length)];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
