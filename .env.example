# Copy to .env.local for local dev. On Vercel, set these in Project > Settings > Environment Variables.

# Shared secret the Pi (Node-RED) sends as "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 32
INGEST_TOKEN=change-me

# Upstash Redis (Vercel Marketplace > Upstash adds KV_REST_API_URL / KV_REST_API_TOKEN automatically).
# Leave empty locally to use the in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Minutes without an update before a valve shows STALE.
NEXT_PUBLIC_STALE_MINUTES=15
